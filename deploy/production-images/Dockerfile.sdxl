ARG BASE_IMAGE
FROM ${BASE_IMAGE}

COPY env/ /opt/python/
COPY wheels/ /offline/wheels/
COPY --chown=1000:1000 sdk/ /opt/mediacenter/
RUN chmod -R a+rX /opt/mediacenter

ENV PATH=/opt/python/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/opt/python/lib PYTHONPATH=/opt/mediacenter \
    PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_INDEX=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 HOME=/tmp

RUN /opt/python/bin/conda-unpack \
    && /opt/python/bin/python -m pip install --no-index --no-deps --find-links=/offline/wheels \
       redis==5.3.1 PyJWT==2.12.1 async-timeout==5.0.1 typing_extensions==4.16.0 peft==0.17.1 \
    && /opt/python/bin/python -m pip check \
    && /opt/python/bin/python -B -c \
       "import torch,diffusers,transformers,peft,redis; import mediacenter.worker_cli,mediacenter.adapters.sdxl"

USER 1000:1000
WORKDIR /opt/mediacenter
ENTRYPOINT ["/opt/python/bin/python","-B","-u","-m","mediacenter.worker_cli"]
