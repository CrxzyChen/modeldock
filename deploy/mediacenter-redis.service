[Unit]
Description=MediaCenter private Redis transport
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/bin/docker update --memory 4g --memory-swap 4g mediacenter-redis
ExecStart=/usr/bin/docker start -a mediacenter-redis
ExecStop=/usr/bin/docker stop --time 10 mediacenter-redis
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/docker.sock

[Install]
WantedBy=default.target
