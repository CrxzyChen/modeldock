# Render validated SERVER / INSTANCE / EPOCH / usernames and SHA256 secrets.
# Credentials are unique per instance epoch; never use a MediaCenter API Key.
# Multiple selectors prevent the union-of-keys / union-of-commands ACL bug.
# Controller owns group creation; neither role can delete streams or groups.
user default off
user ${WORKER_USER} reset resetchannels on #${WORKER_SECRET_SHA256} -@all +ping +multi +exec +discard +unwatch (~mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:commands ~mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:control +xreadgroup +xack +xpending +xclaim) (~mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:ingress +rpush) (&mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:telemetry:heartbeat &mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:telemetry:progress +publish) (~mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:diagnostics +hset +hscan)
user ${SERVER_USER} reset resetchannels on #${SERVER_SECRET_SHA256} -@all +ping +config|get (~mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:commands ~mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:control +xadd +xgroup|create) (~mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:events +type +xadd +xgroup|create +xreadgroup +xack +xpending +xclaim) (&mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:telemetry:heartbeat &mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:telemetry:progress +subscribe +unsubscribe) (~mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:diagnostics +type +hset +hscan) (~mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:ingress +type +lindex +lpop) (~mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:ingress ~mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:events ~mc:v1:${SERVER}:worker:${INSTANCE}:${EPOCH}:diagnostics +eval)
